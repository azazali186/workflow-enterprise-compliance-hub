# --- Server ---
PORT=8080
ENV=development
LOG_LEVEL=debug
# Maximum request body size in bytes (8 MiB).
MAX_BODY_SIZE=8388608

# --- PostgreSQL (GORM) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/compliance-hub?sslmode=disable

# --- Redis (optional; falls back to in-memory cache when unreachable) ---
REDIS_URL=redis://localhost:6379

# --- NATS (optional; falls back to in-process pub/sub when unreachable) ---
NATS_URL=nats://localhost:4222

# --- JWT ---
JWT_SECRET=your-secret-key
JWT_EXPIRY=24h

# --- At-rest encryption (AES-256-GCM) ---
# 32-byte key as hex (64 chars) or base64 (44 chars). Encrypts outbox event
# payloads and models.Secret columns. Required when ENV != development.
# Generate one with:  openssl rand -hex 32
ENCRYPTION_KEY=

# Key rotation: comma-separated previous key(s) kept readable (dual-read)
# while AUTO_REENCRYPT migrates old rows to ENCRYPTION_KEY. On rotation, set
# ENCRYPTION_KEY to the new key, ENCRYPTION_KEY_PREVIOUS to the old one, and
# restart; remove ENCRYPTION_KEY_PREVIOUS only after a boot reports 0 rows
# re-encrypted.
ENCRYPTION_KEY_PREVIOUS=
# Migrate old-key ciphertext (outbox payloads, Secret columns) to the current
# key on every boot (default on). Idempotent.
AUTO_REENCRYPT=true

# --- Logging ---
# text | json (json recommended for production log aggregation)
LOG_FORMAT=text

# --- CORS ---
# Comma-separated browser origins allowed to call the API with credentials.
# When empty, the API answers "*" without credentials (safe default).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Bootstrap admin (created by rbac.Seed on server start) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-prod

# --- WebSocket ---
WS_MAX_CONNECTIONS=1000
WS_PING_INTERVAL=30s

# --- Workers ---
RATE_LIMIT_PER_MINUTE=60
DEADLINE_JOB_INTERVAL=1m
# How often the transactional outbox dispatcher polls for pending events.
OUTBOX_POLL_INTERVAL=1s

# Sync the route -> permission table + api-gateway-permissions cache key on
# every server start (default on). Roles and the admin user are always seeded.
AUTO_SYNC_PERMISSIONS=true
